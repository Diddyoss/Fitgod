# Supabase — optional. Without these, Fitgod runs fully local (IndexedDB + localStorage).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — optional. Without a key, garment tagging falls back to the manual form.
OPENROUTER_API_KEY=
# Vision primary. Verified on OpenRouter 2026-07-26.
# NOTE: google/gemini-3-flash-preview no longer exists — do not use it.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Vision fallback, deliberately a different model family.
OPENROUTER_VISION_FALLBACK=qwen/qwen3.7-plus
